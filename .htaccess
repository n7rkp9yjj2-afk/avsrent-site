RewriteEngine On

# убрать .html из адresu (redirect 301, zeby nie bylo duplikatow w Google)
RewriteCond %{THE_REQUEST} /([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# pokazywac wlasciwy plik .html, nawet jesli w adresie go nie ma
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# index.html -> korzen strony
RewriteRule ^index$ / [R=301,L]

# wlasna strona 404
ErrorDocument 404 /404.html
